# Copy to .env.local and fill in. Never commit real secrets.
#
# Every variable below is read by the application; nothing else is.
# Use TEST-mode / sandbox credentials on a developer machine and keep live
# credentials only on the production host. An empty value means "not configured".

# --- Site -------------------------------------------------------------------

# Canonical site origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.natalieflemons.com

# --- Admin dashboard (/admin) -----------------------------------------------

# Leave ADMIN_PASSWORD empty to disable admin sign-in.
ADMIN_PASSWORD=
# Secret for signing admin session cookies. Set a long random value in
# production (e.g. `openssl rand -base64 48`); changing it signs every admin
# out. If empty, sessions are signed with ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
# Number of reverse proxies in front of the app (default 1). The login throttle
# takes the client address that many entries from the right of X-Forwarded-For.
TRUSTED_PROXY_HOPS=

# Where admin-managed data (books.json, videos.json, uploads, calendar
# connection) is stored. Must be a persistent, writable directory in
# production. Defaults to ./storage
MEDIA_STORAGE_DIR=
# Maximum upload size in MB (default 1024).
MEDIA_MAX_UPLOAD_MB=
# Set to "true" to make the admin dashboard read-only: sign-in and all read
# views work, but every write action (books, videos, files, calendar,
# newsletter delete) is refused with an error. Use this in production when
# content is committed to the repository (storage/ is tracked in git) and the
# filesystem is not writable or should not be modified at runtime.
ADMIN_READONLY=

# --- Stripe (book checkout, admin Donations / Book Sales) --------------------

# Secret key. sk_test_… locally, sk_live_… in production only.
STRIPE_SECRET_KEY=
# Book delivery. A shipping address is always collected at checkout.
# Countries books ship to, comma-separated ISO codes (default US,CA).
CHECKOUT_SHIPPING_COUNTRIES=
# Optional: Stripe Shipping Rate id (shr_…, Stripe Dashboard → Shipping rates)
# charged on every book order. Empty: no shipping fee is added.
STRIPE_SHIPPING_RATE_ID=
# Set to "true" to have Stripe Tax calculate sales tax. Stripe Tax must be set
# up in the Stripe account first, or checkout will fail.
STRIPE_AUTOMATIC_TAX=
# Donation Payment Link — the "Give by Card" button. Must be a
# donate.stripe.com or buy.stripe.com URL (Stripe Dashboard → Payment Links);
# anything else is ignored and the default link in src/content/site.ts is used.
STRIPE_DONATION_PAYMENT_LINK=

# --- Newsletter (MailerLite) -------------------------------------------------

# Set to "mailerlite" to enable sign-up. Empty: the form tells visitors
# sign-up is unavailable.
NEWSLETTER_PROVIDER=
MAILERLITE_API_KEY=
# Optional: MailerLite group id new subscribers are added to.
MAILERLITE_GROUP_ID=

# --- Contact form (Resend) ---------------------------------------------------

# Set to "resend" to enable delivery. Empty: the form directs visitors to
# email info@natalieflemons.com.
CONTACT_EMAIL_PROVIDER=
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g.
#   Natalie Flemons Ministries <website@natalieflemons.com>
# If empty, Resend's test sender (onboarding@resend.dev) is used, which only
# delivers to the Resend account owner's own address.
CONTACT_EMAIL_FROM=
# Inbox that receives contact messages (default info@natalieflemons.com).
CONTACT_EMAIL_TO=

# --- Google Calendar on /events ---------------------------------------------

# Option A — Public iCal feed (no Google Cloud setup needed):
# In Google Calendar → Settings for the calendar → tick "Make available to public",
# then copy the "Public address in iCal format" URL.
GOOGLE_CALENDAR_ICAL_URL=
#
# Option B — OAuth (admin signs in at /admin/calendar):
# Create a "Web application" OAuth client in Google Cloud Console with the
# Google Calendar API enabled; the exact redirect URI to register is shown on
# /admin/calendar (default: <site origin>/api/admin/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the redirect URI (e.g. behind a proxy that rewrites hosts).
GOOGLE_REDIRECT_URI=

# --- Analytics and error reporting (optional) --------------------------------

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty: no analytics script
# is loaded. If you set this, name Google Analytics in the Privacy Policy.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Server errors are always written to the server log as JSON. Set a webhook
# URL (e.g. a Slack incoming webhook) to also be notified of each one.
ERROR_REPORT_WEBHOOK_URL=
