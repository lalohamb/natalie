# Copy to .env.local and fill in. Never commit real secrets.

# Canonical site origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.natalieflemons.com

# Newsletter provider (pending decision — see docs/reports/IMPLEMENTATION-PLAN.md §9).
# Leave empty: the sign-up form will tell visitors sign-up is unavailable.
NEWSLETTER_PROVIDER=

# Contact form email provider (pending decision — see docs/KNOWN-GAPS.md G-24).
# Leave empty: the contact form will direct visitors to email info@natalieflemons.com.
# Supported values: resend (once implemented in M2)
CONTACT_EMAIL_PROVIDER=

# Admin dashboard (/admin). Leave ADMIN_PASSWORD empty to disable admin sign-in.
ADMIN_PASSWORD=
# Optional: separate secret for signing admin session cookies (defaults to ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=

# Where admin-managed videos.json and uploaded media files are stored.
# Must be a persistent, writable directory in production. Defaults to ./storage
MEDIA_STORAGE_DIR=
# Maximum upload size in MB (default 1024).
MEDIA_MAX_UPLOAD_MB=

# Google Calendar on /events — admin signs in with Google at /admin/calendar.
# Create a "Web application" OAuth client in Google Cloud Console with the
# Google Calendar API enabled; the exact redirect URI to register is shown on
# /admin/calendar (default: <site origin>/api/admin/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the redirect URI (e.g. behind a proxy that rewrites hosts).
GOOGLE_REDIRECT_URI=
