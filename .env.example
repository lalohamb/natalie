# Copy to .env.local and fill in. Never commit real secrets.

# Canonical site origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.natalieflemons.com

# Newsletter provider (pending decision — see docs/reports/IMPLEMENTATION-PLAN.md §9).
# Leave empty: the sign-up form will tell visitors sign-up is unavailable.
NEWSLETTER_PROVIDER=

# Contact form email provider (pending decision — see docs/KNOWN-GAPS.md G-24).
# Leave empty: the contact form will direct visitors to email info@natalieflemons.com.
# Supported values: resend (once implemented in M2)
CONTACT_EMAIL_PROVIDER=
